# ==========================================
# Medieval II: Total War RL Battle AI
# .gitignore
# ==========================================

# Game proprietary binaries and asset packs (from Steam / disk)
game/
game-*/
medieval2/
steam_dot/
steam_home/
wineprefix/
wineprefix-*/
*.pack
*.exe
*.dll
*.dat
*.idx

# Keep launcher C source and custom Lua scripts if placed in game/
!game/m2tweop_starter.c
!game/youneuoy_Data/plugins/lua/luaPluginScript.lua

# Python & Trainer
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Dynamic battle artifacts & RL training logs
workspace/episodes/
workspace/replays/
workspace/processed/
workspace/*.png
workspace/*.log
workspace/m2tweop_loaded.txt
workspace/rl_status.txt
workspace/wine_crash.log
workspace/weights_latest.json
workspace/scenario.json

# Keep trainer source code inside workspace/
!workspace/trainer/
!workspace/rl_battle_ai.lua
!workspace/launch_scenario_battle.py

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
